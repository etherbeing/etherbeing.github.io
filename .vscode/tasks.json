{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker: dev deps up",
      "type": "shell",
      "command": "docker compose up -d postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: dev deps down",
      "type": "shell",
      "command": "docker compose stop postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "pnpm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": ".*Local.*"
        }
      }
    },
    {
      "label": "backend: runserver",
      "type": "shell",
      "command": "/usr/bin/python3 src/etherbeing/manage.py runserver 127.0.0.1:7000",
      "options": {
        "cwd": "${workspaceFolder}/api",
        "env": {
          "DJANGO_ENV_FILE": "${workspaceFolder}/api/.env.development"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Starting development server at"
        }
      },
      "dependsOn": ["backend: migrate"]
    },
    {
      "label": "backend: ensure db",
      "type": "shell",
      "command": "docker compose exec -T postgres sh -lc \"createdb -U \\\"$(cat /run/secrets/postgres_user)\\\" \\\"$POSTGRES_DB\\\" 2>/dev/null || true\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": ["backend: wait for postgres"]
    },
    {
      "label": "backend: wait for postgres",
      "type": "shell",
      "command": "docker compose exec -T postgres sh -lc \"until pg_isready -U \\\"$(cat /run/secrets/postgres_user)\\\" -d \\\"$POSTGRES_DB\\\"; do sleep 1; done\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": ["docker: dev deps up"]
    },
    {
      "label": "backend: migrate",
      "type": "shell",
      "command": "/usr/bin/python3 src/etherbeing/manage.py migrate",
      "options": {
        "cwd": "${workspaceFolder}/api",
        "env": {
          "DJANGO_ENV_FILE": "${workspaceFolder}/api/.env.development"
        }
      },
      "problemMatcher": [],
      "dependsOn": ["backend: ensure db"]
    },
    {
      "label": "dev: full stack",
      "dependsOrder": "parallel",
      "dependsOn": [
        "backend: runserver",
        "frontend: dev"
      ],
      "problemMatcher": []
    }
  ]
}
