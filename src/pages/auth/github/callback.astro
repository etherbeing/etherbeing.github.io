---
import Layout from "@/components/Layout.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL;
---

<Layout>
    <section class="min-h-[60vh] flex items-center justify-center px-4">
        <div class="w-full max-w-xl rounded-[28px] border border-white/12 bg-slate-950/70 p-8 text-center shadow-2xl shadow-slate-950/40 backdrop-blur-xl">
            <p class="text-xs uppercase tracking-[0.35em] text-cyan-200/70">GitHub Admin Login</p>
            <h1 class="mt-4 text-3xl font-semibold text-white">Finishing sign-in</h1>
            <p class="mt-3 text-sm text-slate-300">
                Redirecting your GitHub authorization back to the Django admin.
            </p>
            <p class="mt-6 text-xs text-slate-400">
                If nothing happens, use the fallback link below.
            </p>
            <a
                id="admin-callback-link"
                href={`${apiUrl}/api/auth/github/callback/`}
                class="mt-4 inline-flex rounded-full border border-cyan-300/30 bg-cyan-300/10 px-5 py-2 text-sm font-medium text-cyan-100 transition hover:bg-cyan-300/20"
            >
                Continue to admin
            </a>
        </div>
    </section>

    <script is:inline define:vars={{ apiUrl }}>
        const search = window.location.search || "";
        const target = `${apiUrl}/api/auth/github/callback/${search}`;
        const fallbackLink = document.getElementById("admin-callback-link");
        if (fallbackLink instanceof HTMLAnchorElement) {
            fallbackLink.href = target;
        }
        window.location.replace(target);
    </script>
</Layout>
