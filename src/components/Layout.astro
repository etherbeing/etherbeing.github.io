---
import "../styles/global.css";
import GradualBlur from "./react/GradualBlur";
import LiquidEther from "./hp/liquid-ether/LiquidEther.tsx";
import Header from "./react/Header";
import { fetchSiteConfiguration } from "@/lib/siteConfiguration";

const siteConfiguration = await fetchSiteConfiguration(import.meta.env.PUBLIC_API_URL);
---

<html lang="en" class="bg-black text-gray-200 font-sans dark">
    <head>
        <meta charset="utf-8" />
        <title>{siteConfiguration.site_name}</title>
        <meta name="description" content={siteConfiguration.site_description}>
        <link rel="icon" href={siteConfiguration.favicon_url} />
        <link rel="apple-touch-icon" href={siteConfiguration.favicon_url} />
        <link rel="manifest" href="/manifest.webmanifest" />
        <meta name="theme-color" content={siteConfiguration.theme_color} />
        <meta name="google-site-verification" content="ZQmWAHzUa_f5pPJqvbfhh9ZlVJZwfjIY2l1X261WgX4" />
        <meta name="google-adsense-account" content="ca-pub-4134819476240449">
        <meta name="generator" content={Astro.generator} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta property="og:title" content={siteConfiguration.site_name}>
        <meta property="og:description" content={siteConfiguration.site_description}>
        <meta property="og:url" content="https://etherbeing.github.io">
        <script id="usercentrics-cmp" src="https://app.usercentrics.eu/browser-ui/latest/loader.js" data-settings-id="jxvXNqs9Dca0Sf" async></script>
    </head>
    <body
        class={"max-w-screen overflow-x-hidden" +
            (Astro.props.class ? " " + Astro.props.class : "")}
    >
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-8WZ5H8DJ8W"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-8WZ5H8DJ8W');
        </script>
        <script is:inline>
            if ("serviceWorker" in navigator) {
                window.addEventListener("load", () => {
                    navigator.serviceWorker.register("/sw.js").catch(() => undefined);
                });
            }
        </script>
        <LiquidEther
            style={{
                position: "fixed",
            }}
            className="w-screen h-screen left-0 top-0 -z-10"
            client:only="react"
            colors={["#5227FF", "#FF9FFC", "#B19EEF"]}
            mouseForce={20}
            cursorSize={50}
            isViscous={true}
            viscous={30}
            iterationsViscous={32}
            iterationsPoisson={32}
            resolution={0.25}
            isBounce={false}
            autoDemo={true}
            autoSpeed={0.5}
            autoIntensity={2.2}
            takeoverDuration={0.25}
            autoResumeDelay={250}
            autoRampDuration={1.6}
        />
        <Header client:only="react" />
        <main class="w-full md:w-4xl px-3 md:px-0 mx-auto">
            <slot />
        </main>
        <GradualBlur
            client:only="react"
            target="page"
            position="top"
            height="3rem"
            strength={2}
            divCount={5}
            curve="bezier"
            exponential={true}
            opacity={1}
        />
    </body>
</html>
